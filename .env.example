# DriveSense environment configuration.
# Copy to .env (git-ignored) and adjust:   Copy-Item .env.example .env
# Every value has a working local default, so .env is optional for local development.
# NEVER commit a real .env or real cloud credentials.

# --- PostgreSQL (docker compose "db" service) --------------------------------------------------
POSTGRES_DB=drivesense
POSTGRES_USER=drivesense
# Local-only development password. Use letters/digits/underscore only (it is embedded in a URL).
# Changing it after the first start requires: docker compose down -v
POSTGRES_PASSWORD=drivesense_local_dev

# --- Host ports --------------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
TEST_DB_PORT=5433

# --- Backend (FastAPI) -------------------------------------------------------------------------
# Set automatically inside Docker Compose. Needed only when running uvicorn on the host,
# e.g. against a database you started yourself.
# DATABASE_URL=postgresql+psycopg://drivesense:drivesense_local_dev@localhost:5432/drivesense
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
EVENTS_DEFAULT_LIMIT=100
EVENTS_MAX_LIMIT=500
DB_CONNECT_TIMEOUT_SECONDS=60
# POST /api/events. Leave on locally (tests, CI, replay). Azure sets it to false:
# devices send through IoT Hub there and the API has a public address.
HTTP_INGEST_ENABLED=true

# --- Backend tests (host-side pytest) -----------------------------------------------------------
# Disposable database from: docker compose --profile test up -d db-test
TEST_DATABASE_URL=postgresql+psycopg://drivesense_test:drivesense_test@localhost:5433/drivesense_test

# --- Phone simulator ----------------------------------------------------------------------------
# Device connection string from IoT Hub (az iot hub device-identity connection-string show).
# It is a password: keep it only in your own .env, never in Git.
DRIVESENSE_DEVICE_CONNECTION_STRING=
# Old HTTP path, kept for tests and as a fallback only.
DRIVESENSE_API_URL=http://localhost:8000

# --- IoT Hub ingestor (docker compose --profile iothub up) ----------------------------------------
# Event Hub-compatible connection string: terraform output -raw iothub_events_connection_string
IOTHUB_EVENTS_CONNECTION_STRING=
# Leave unset locally ($Default); Azure uses the "ingestor" consumer group.
# IOTHUB_CONSUMER_GROUP=

# --- Frontend (Vite) ----------------------------------------------------------------------------
# Leave empty: the dashboard calls the API on its own origin (nginx / Vite proxy forwards it).
VITE_API_BASE_URL=
# Where `npm run dev` proxies /api and /health.
VITE_API_PROXY_TARGET=http://localhost:8000
